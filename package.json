{
  "activationEvents": [
    "onLanguage:al",
    "onLanguage:json",
    "onLanguage:jsonc",
    "workspaceContains:**/*.al"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [{
      "id": "al",
      "extensions": [".al"]
    }],
    "commands": [
      {
        "command": "alConvention.fixAllNaming",
        "title": "ALTC: Fix All Name in Current File"
      }
    ],
    "configuration": {
      "title": "AL Advanced Convention Setup",
      "properties": {
        "alConvention.alObjectPrefix": {
          "type": "string",
          "default": "ATL_",
          "scope": "resource",
          "description": "Mandatory prefix for AL Objects (Table, Page, Codeunit, etc.)"
        },
        "alConvention.namingStyle": {
          "type": "object",
          "default": {
            "procedure": "PascalCase",
            "parameter": "PascalCase",
            "local_variable": "PascalCase",
            "global_variable": "PascalCase",
            "ProcedureParameter": "PascalCase"
          },
          "scope": "resource",
          "description": "Naming style format rule for each component type."
        },
        "alConvention.showShortTypeInName": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Toggle to include or exclude short type name inside variables/parameters."
        },
        "alConvention.typeAbbreviations": {
          "type": "object",
          "default": {
            "Record": "rec",
            "Page": "pag",
            "Codeunit": "cu",
            "Query": "que",
            "Report": "rep",
            "Integer": "int",
            "Text": "txt",
            "Code": "cod",
            "Boolean": "boo",
            "Decimal": "dec",
            "XmlPort": "xml",
            "JsonObject": "jso",
            "JsonArray": "jsa",
            "Dictionary": "dic",
            "List": "lst",
            "JsonToken": "jst",
            "Date": "dat",
            "DateTime": "dtm",
            "Time": "tim"
          },
          "scope": "resource",
          "description": "Short type abbreviations mapping used for prefixes."
        },
        "alConvention.scopePrefixes": {
          "type": "object",
          "default": {
            "ProcedureParameter": "p",
            "globalVariablePrefix": "g",
            "localVariablePrefix": "l"
          },
          "scope": "resource",
          "description": "Prefix indicators for scopes and temporary states."
        },
        "alConvention.temporaryRecordPrefix": {
          "type": "string",
          "default": "temp",
          "scope": "resource",
          "description": "Prefix indicator for temporary records."
        },
        "alConvention.temporaryPrefixBeforeScope": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "If true, temporary prefix is placed before scope prefix (e.g., TempgItem, TemplItem). If false, it is placed after (e.g., gTempItem, lTempItem)."
        }
      }
    }
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "name": "al-team-convention",
  "icon": "logo.png",
  "displayName": "AL Team Convention",
  "version": "1.1.8",
  "publisher": "HaThanhHuy"
}